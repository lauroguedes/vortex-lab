// Cloudflare Workers static-assets deployment: `npm run deploy`
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vortex-lab",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "vortex-lab.lauroguedes.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
